# Copy this file to server/.env. Credentials stay on the Express server.
# Paste the API Read Access Token from https://www.themoviedb.org/settings/api
# Paste the token itself, without the word Bearer. This is the preferred option.
TMDB_READ_ACCESS_TOKEN=

# Optional alternative: your TMDB v3 API key. Used only when the token is empty.
TMDB_API_KEY=

# IGDB: the Twitch application's Client ID used to obtain your app access token.
IGDB_CLIENT_ID=
# Paste only access_token from the Twitch JSON response, without Bearer or quotes.
# When it expires, generate a new app token and restart the server.
IGDB_ACCESS_TOKEN=

# Tenrai works without a key. Optional server key for higher rate limits.
# Sent only by Express as X-Server-Key; do not add a Bearer prefix.
TENRAI_SERVER_KEY=

# Open Library needs no key. Recommended for regular use: a contact email.
# Sent to Open Library in Libra's server-side User-Agent header; not shown in the UI.
OPENLIBRARY_CONTACT_EMAIL=

# The Vite proxy expects the API at this address during development.
# Optional SQLite file location, relative to server/. Created automatically.
LIBRARY_DB_PATH=../database/data/libra.sqlite
HOST=127.0.0.1
PORT=3001

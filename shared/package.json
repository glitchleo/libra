{
  "name": "@libra/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    "./search": {
      "types": "./dist/types/search.d.ts",
      "default": "./dist/types/search.js"
    },
    "./library": {
      "types": "./dist/types/library.d.ts",
      "default": "./dist/types/library.js"
    },
    "./manual-entry": {
      "types": "./dist/types/manual-entry.d.ts",
      "default": "./dist/types/manual-entry.js"
    }
  }
}
